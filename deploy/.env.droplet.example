# DigitalOcean droplet .env template for mosque system
# Copy this to .env on the droplet and fill in real values:
#   cp deploy/.env.droplet.example /opt/mosque/.env
#   nano /opt/mosque/.env

APP_NAME=Smart Mosque System
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mosque.example.com
APP_TIMEZONE=Asia/Kuala_Lumpur

# --- Database (droplet MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mosque
DB_USERNAME=mosque
DB_PASSWORD=change-me

# --- Sessions & cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# --- Filesystem (uploads) ---
FILESYSTEM_DRIVER=local

# --- Access codes (used by admin/treasurer registration) ---
ADMIN_CODE=change-me
TREASURER_CODE=change-me

# --- Mail (Resend) ---
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Optional: Cloudinary for file uploads (leave empty to use local storage) ---
CLOUDINARY_URL=
